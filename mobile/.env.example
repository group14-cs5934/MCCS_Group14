# Copy this file to mobile/.env to override settings. Never commit .env.
# Restart `npm start` after changing it (Expo reads it at startup).
# EXPO_PUBLIC_ values are built into the app where anyone can read them: never put secrets here.

# Backend base URL, no trailing slash. Leave unset in development: the app then uses port 8000
# on the computer running Expo. Set it to use a deployed API, or when running Expo with --tunnel.
# EXPO_PUBLIC_API_URL=https://api.example.com
