# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Required ---

# Postgres connection string. For Supabase use the "Connection string" from
# Project Settings -> Database, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mccs

# Supabase project URL: Project Settings -> API -> Project URL. Used to verify sign-in tokens.
# e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# --- Optional ---

# Only for Supabase projects still on the legacy JWT secret (Project Settings -> API -> JWT
# Settings). Leave unset if the project uses JWT signing keys (the default for new projects).
# SUPABASE_JWT_SECRET=

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Leave empty to allow none. The native app doesn't need an entry; Expo web runs on :8081.
CORS_ORIGINS=http://localhost:8081
