# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Required ---

# Postgres connection string. For Supabase use the "Connection string" from
# Project Settings -> Database, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mccs

# --- Optional ---

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
